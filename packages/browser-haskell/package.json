{
  "name": "@live-codes/browser-haskell",
  "version": "0.1.2",
  "description": "Run Haskell entirely in the browser, powered by MicroHs. No server, no install.",
  "keywords": [
    "haskell",
    "microhs",
    "wasm",
    "webassembly",
    "playground",
    "livecodes",
    "compiler"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/browser-haskell.mjs",
  "module": "./dist/browser-haskell.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser-haskell.mjs",
      "default": "./dist/browser-haskell.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=18"
  }
}
